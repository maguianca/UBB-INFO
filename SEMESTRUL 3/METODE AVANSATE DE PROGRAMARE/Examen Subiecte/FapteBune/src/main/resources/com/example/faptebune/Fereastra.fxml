<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="146.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.faptebune.controller.FereastraController">
    <children>
        <TabPane prefHeight="383.0" prefWidth="562.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Doresc sa ajut!">
                    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10;">
                        <VBox alignment="CENTER" spacing="15">
                            <TableView fx:id="tabel1" prefHeight="150.0" prefWidth="250.0">
                                <columns>
                                    <TableColumn fx:id="titlu" prefWidth="30.0" text="Titlu" />
                                    <TableColumn fx:id="descriere" minWidth="5.0" prefWidth="71.0" text="Descriere" />
                                    <TableColumn fx:id="deadline" minWidth="0.0" prefWidth="43.0" text="Deadline" />
                                    <TableColumn fx:id="omnevoie" prefWidth="51.0" text="omNevoie" />
                                    <TableColumn fx:id="status" prefWidth="46.0" text="status" />
                                </columns>
                            </TableView>
                            <Button fx:id="ajut" onAction="#handleAjut" text="Ajut" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="15">
                            <TableView fx:id="tabel2" prefHeight="200.0" prefWidth="248.0">
                                <columns>
                                    <TableColumn fx:id="titlu2" prefWidth="75.0" text="Titlu" />
                                    <TableColumn fx:id="descriere2" prefWidth="75.0" text="Descriere" />
                                    <TableColumn fx:id="deadline2" prefWidth="75.0" text="Deadline" />
                                </columns>
                            </TableView>
                        </VBox>
                    </HBox>
                </Tab>
                <Tab text="Doresc sa fiu ajutat!">
                    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10;">
                        <VBox alignment="CENTER" spacing="10">
                            <TextField fx:id="titlufield" promptText="Titlu" />
                            <TextField fx:id="descrierefield" promptText="Descriere" />
                            <Button fx:id="ajutat" onAction="#handleAjutat" text="Ajutat" />
                            <DatePicker fx:id="deadlinefield" />
                        </VBox>
                    </HBox>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
