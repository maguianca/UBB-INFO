          <TableColumn fx:id="nume_client" prefWidth="260.0" text="Nume" />
        </columns>
      </TableView>
      <Label layoutX="31.0" layoutY="233.0" prefHeight="17.0" prefWidth="234.0" text="Media comenzilor pe zi din ultimele 3 luni: " />
      <Label layoutX="31.0" layoutY="262.0" prefHeight="17.0" prefWidth="108.0" text="Cel mai fidel client:" />
      <Label fx:id="nume_client_fidel" layoutX="151.0" layoutY="262.0" prefHeight="17.0" prefWidth="99.0" text="NUME(curse)" />
      <Label fx:id="media" layoutX="265.0" layoutY="233.0" text="0" />
   </children>
</AnchorPane>
