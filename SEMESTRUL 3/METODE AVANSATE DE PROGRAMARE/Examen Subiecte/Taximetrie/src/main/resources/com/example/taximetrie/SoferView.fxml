          <TableColumn fx:id="nume" prefWidth="197.0" text="Nume" />
        </columns>
      </TableView>
      <Label layoutX="321.0" layoutY="28.0" prefHeight="17.0" prefWidth="123.0" text="Nume Clienti:" />
