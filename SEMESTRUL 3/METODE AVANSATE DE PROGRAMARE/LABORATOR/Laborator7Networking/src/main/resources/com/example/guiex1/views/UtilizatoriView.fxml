<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="230.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.guiex1.controller.UtilizatoriController">
   <children>
      <Label layoutX="169.0" layoutY="31.0" prefHeight="69.0" prefWidth="286.0" text="SIGN IN" textOverrun="CENTER_ELLIPSIS">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="13.0" />
         </font>
      </Label>
      <TextField fx:id="fieldusername" layoutX="134.0" layoutY="109.0" promptText="Enter Username" />
      <Button layoutX="156.0" layoutY="217.0" mnemonicParsing="false" onAction="#handleConnectButton" text="Log In ">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="18.0" />
         </font>
      </Button>
      <Button layoutX="32.0" layoutY="327.0" mnemonicParsing="false" onAction="#handleDeleteUser" prefHeight="21.0" prefWidth="102.0" text="Delete Account">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="14.0" />
         </font>
      </Button>
      <Button layoutX="169.0" layoutY="327.0" mnemonicParsing="false" onAction="#handleUpdateUser" prefHeight="25.0" prefWidth="108.0" text="Update User">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="14.0" />
         </font>
      </Button>
      <Button layoutX="301.0" layoutY="327.0" mnemonicParsing="false" onAction="#handleAddUser" text="Sign Up">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="14.0" />
         </font>
      </Button>
      <Label layoutX="32.0" layoutY="154.0" text="Password:" />
      <Label layoutX="32.0" layoutY="113.0" text="Username:" />
      <PasswordField fx:id="fieldpass" layoutX="134.0" layoutY="152.0" promptText="Enter Password" />
   </children>
</AnchorPane>
